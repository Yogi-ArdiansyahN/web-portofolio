---
import Layout from "../layouts/Layout.astro";
import App from "../components/App.jsx";
import { copy } from "../i18n.js";

const initial = copy.en;
---

<Layout
  title={initial.home.documentTitle}
  description={initial.home.description}
  ogLocale={initial.ogLocale}
>
  <App client:load entries={[]} page="home" pathname={Astro.url.pathname} />
</Layout>
