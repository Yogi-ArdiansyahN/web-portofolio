---
import Layout from "../layouts/Layout.astro";
import App from "../components/App.jsx";

const files = import.meta.glob<string>("../../portfolio/*.md", {
  eager: true,
  query: "?raw",
  import: "default",
});

function parseEntry(path: string, raw: string) {
  const text = raw.replace(/\r\n/g, "\n");
  const start = text.indexOf("---\n");
  if (start !== 0) throw new Error(`Missing frontmatter: ${path}`);
  const end = text.indexOf("\n---\n", 4);
  if (end === -1) throw new Error(`Invalid frontmatter: ${path}`);

  const frontmatter = text.slice(4, end);
  const body = text.slice(end + 5);
  const meta: Record<string, string> = {};

  for (const line of frontmatter.split("\n")) {
    const separator = line.indexOf(":");
    if (separator === -1) continue;
    const key = line.slice(0, separator).trim();
    let value = line.slice(separator + 1).trim();
    if (
      (value.startsWith('"') && value.endsWith('"')) ||
      (value.startsWith("'") && value.endsWith("'"))
    ) {
      value = value.slice(1, -1);
    }
    meta[key] = value;
  }

  const section = (name: string) => {
    const heading = `## ${name}`;
    const start = body.indexOf(heading);
    if (start === -1) return "";
    const from = start + heading.length;
    const next = body.indexOf("\n## ", from);
    return body.slice(from, next === -1 ? body.length : next).trim();
  };

  const bullets = (name: string) =>
    section(name)
      .split("\n")
      .filter((line: string) => line.startsWith("* "))
      .map((line: string) => line.slice(2).trim());

  let techStack: string[] = [];
  try {
    const parsed = JSON.parse(meta.tech_stack ?? "[]");
    techStack = Array.isArray(parsed) ? parsed.filter((v) => typeof v === "string") : [];
  } catch {
    techStack = [];
  }

  let platform: string[] = [];
  try {
    const parsed = JSON.parse(meta.platform ?? "[]");
    platform = Array.isArray(parsed) ? parsed.filter((v) => typeof v === "string") : [];
  } catch {
    platform = [];
  }

  return {
    slug: path.split("/").pop()!.replace(/\.md$/, ""),
    title: { en: meta.title ?? "", id: meta.title_id ?? "" },
    scope: { en: meta.scope ?? "", id: meta.scope_id ?? "" },
    experience: meta.experience ?? "",
    techStack,
    platform,
    description: {
      en: section("Business Context"),
      id: section("Konteks Bisnis"),
    },
    bullets: {
      en: bullets("Role & System Flow"),
      id: bullets("Peran & Alur Sistem"),
    },
    highlight: {
      en: section("Technical Notes"),
      id: section("Highlight Teknis"),
    },
  };
}

const entries = Object.entries(files)
  .map(([path, raw]) => parseEntry(path, raw))
  .sort((a, b) => a.title.en.localeCompare(b.title.en, "en"));
---

<Layout>
  <App client:load entries={entries} />
</Layout>
