---
import "../styles/global.css";
import { copy } from "../i18n.js";
import { profile } from "../data/resume.js";

const initial = copy.en;
const {
  title = initial.home.documentTitle,
  description = initial.home.description,
  ogLocale = initial.ogLocale,
  ogImageAlt = initial.ogImageAlt,
} = Astro.props;

const site = Astro.site ?? new URL("https://yogian.my.id");
const canonical = new URL(Astro.url.pathname, site).toString();
const socialImage = new URL("/assets/img/project/top-up-1.png", site).toString();
const language = ogLocale === "id_ID" ? "id" : "en";
const alternateLocale = language === "id" ? "en_US" : "id_ID";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site}#website`,
      url: new URL("/", site).toString(),
      name: profile.name,
      inLanguage: language,
      publisher: { "@id": `${site}#person` },
    },
    {
      "@type": "Person",
      "@id": `${site}#person`,
      name: profile.name,
      jobTitle: profile.role,
      url: new URL("/", site).toString(),
      email: profile.email,
      sameAs: [profile.github, profile.instagram],
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: language,
      isPartOf: { "@id": `${site}#website` },
      about: { "@id": `${site}#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0B0B" />
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = window.localStorage.getItem("portfolio-theme");
        } catch {
          saved = null;
        }
        const theme =
          saved === "dark" || saved === "light" ? saved : "dark";
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#0B0B0B" : "#FFFFFF");
      })();
    </script>
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yogi Ardiansyah Nugraha" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1350" />
    <meta property="og:image:height" content="680" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <slot />
    <footer class="mx-auto w-full max-w-screen-lg px-4 pb-8 sm:px-6 lg:px-8">
      <div class="mt-12 flex flex-col gap-2 border-t border-ink/20 pt-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
        <span class="font-bold text-ink">YOGIAN</span>
        <span>2023 - 2026 © Yogi Ardiansyah Nugraha</span>
      </div>
    </footer>
  </body>
</html>
